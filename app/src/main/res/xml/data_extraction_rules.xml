<?xml version="1.0" encoding="utf-8"?>
<!--
    android:allowBackup is "false" for Axiom Calculator, so neither cloud backup
    nor device-to-device transfer rules below are active. They are declared
    explicitly (excluding everything) so the policy is self-documenting even if
    allowBackup is ever revisited. See docs/OFFLINE_AND_PRIVACY.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
